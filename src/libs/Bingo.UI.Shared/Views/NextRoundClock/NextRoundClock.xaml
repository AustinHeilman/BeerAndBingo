<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Bingo.UI.Shared.Converters;assembly=Bingo.UI.Shared"
             x:Class="Bingo.UI.Shared.Views.NextRoundClock.NextRoundClock"
             x:Name="RootClock">

	<ContentView.Resources>
		<converters:InverseBoolConverter x:Key="InverseBoolConverter" />
	</ContentView.Resources>

	<ContentView
        HorizontalOptions="Center"
        VerticalOptions="Center"
        WidthRequest="{OnIdiom Phone=360, Tablet=500, Desktop=600}">

		<Border
            Padding="24,24,24,36"
            Background="#222"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 16"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsVisible="{Binding ViewModel.IsVisible}">

			<ScrollView>
				<VerticalStackLayout Spacing="12">

					<Label Text="Next Round Starts At:"
                           FontSize="20"
                           TextColor="White"
                           HorizontalOptions="Center" />

					<Label Text="{Binding ViewModel.DisplayScheduled}"
                           FontSize="26"
                           TextColor="LightGray"
                           HorizontalOptions="Center" />

					<Label Text="{Binding ViewModel.DisplayCountdown}"
                           FontSize="48"
                           FontAttributes="Bold"
                           TextColor="{Binding ViewModel.CountdownColor}"
                           HorizontalOptions="Center" />

					<StackLayout IsVisible="{Binding ViewModel.IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                                 Spacing="10"
                                 HorizontalOptions="Center">

						<Entry x:Name="MinutesEntry"
                               Placeholder="Enter minutes (e.g. 0.5)"
                               Keyboard="Numeric"
                               WidthRequest="180"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#333}"
                               HorizontalTextAlignment="Center"
                               ClearButtonVisibility="WhileEditing" />

						<HorizontalStackLayout Spacing="12"
                                               HorizontalOptions="Center">
							<Button Text="Set Timer"
                                    Clicked="OnSetTimerClicked"
                                    FontSize="18"
                                    HeightRequest="50"
                                    Padding="12,6"
                                    CornerRadius="8"
                                    BackgroundColor="#3A8CFF"
                                    TextColor="White" />

							<Button Text="Cancel"
                                    Clicked="OnCancelClicked"
                                    FontSize="18"
                                    HeightRequest="50"
                                    Padding="12,6"
                                    CornerRadius="8"
                                    BackgroundColor="#666"
                                    TextColor="White" />
						</HorizontalStackLayout>
					</StackLayout>
				</VerticalStackLayout>
			</ScrollView>
		</Border>
	</ContentView>
</ContentView>
