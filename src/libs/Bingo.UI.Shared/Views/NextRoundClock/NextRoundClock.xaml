<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Bingo.Caller.App.Converters;assembly=Bingo.UI.Shared"
             x:Class="Bingo.UI.Shared.Views.NextRoundClock.NextRoundClock"
             x:Name="RootClock">

	<ContentView.Resources>
		<converters:InverseBoolConverter x:Key="InverseBoolConverter" />
	</ContentView.Resources>

	<Frame Padding="24"
           CornerRadius="16"
           BackgroundColor="#222"
           HasShadow="True"
           WidthRequest="350"
           HeightRequest="300"
           HorizontalOptions="Fill"
           VerticalOptions="Fill"
           IsVisible="{Binding ViewModel.IsVisible}">

		<VerticalStackLayout Spacing="12">

			<Label Text="Next Round Starts At:"
                   FontSize="20"
                   TextColor="White"
                   HorizontalOptions="Center" />

			<Label Text="{Binding ViewModel.DisplayScheduled}"
                   FontSize="26"
                   TextColor="LightGray"
                   HorizontalOptions="Center" />

			<Label Text="{Binding ViewModel.DisplayCountdown}"
                   FontSize="48"
                   FontAttributes="Bold"
                   TextColor="#FFAA44"
                   HorizontalOptions="Center" />

			<StackLayout IsVisible="{Binding ViewModel.IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                         Spacing="10"
                         HorizontalOptions="Center">
				<Entry x:Name="MinutesEntry"
                       Placeholder="Enter minutes..."
                       Keyboard="Numeric"
                       WidthRequest="180"
                       BackgroundColor="White"
                       HorizontalTextAlignment="Center" />
				<Button Text="Set Timer" Clicked="OnSetTimerClicked" />
				<Button Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="#444" TextColor="White" />
			</StackLayout>

		</VerticalStackLayout>
	</Frame>
</ContentView>
    