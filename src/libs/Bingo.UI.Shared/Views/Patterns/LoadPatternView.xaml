<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:core="clr-namespace:Bingo.Core.Patterns;assembly=Bingo.Core"
			 xmlns:patterns="clr-namespace:Bingo.UI.Shared.Views.Patterns.PatternDisplay;assembly=Bingo.UI.Shared"
			 xmlns:controls="clr-namespace:Bingo.UI.Shared.Controls;assembly=Bingo.UI.Shared"
			 x:Class="Bingo.UI.Shared.Views.Patterns.LoadPatternView"
			 x:Name="Root">

	<Grid ColumnDefinitions="*,2*"
		  RowDefinitions="*,Auto"
		  Padding="12"
		  ColumnSpacing="18"
		  RowSpacing="18">

		<!-- 📁 Scrollable Pattern List -->
		<ScrollView Grid.Column="0"
					VerticalOptions="Fill"
					HorizontalOptions="Fill">
			<VerticalStackLayout Spacing="6">
				<Label Text="Saved Patterns"
					   FontSize="16"
					   FontAttributes="Bold"
					   Margin="0,0,0,6" />

				<CollectionView ItemsSource="{Binding SavedPatterns}"
								SelectionMode="Single"
								SelectedItem="{Binding SelectedPattern, Mode=TwoWay}">
					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="core:BingoPattern">
							<Border Padding="6"
									Stroke="Gray"
									BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#1A1A1A}"
									StrokeThickness="1">
								<Label Text="{Binding Name}"
									   FontSize="14" />
							</Border>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>
			</VerticalStackLayout>
		</ScrollView>

		<!-- 🔲 Pattern Preview Grid -->
		<Border Grid.Column="1"
				BackgroundColor="{AppThemeBinding Light=#EFEFEF, Dark=#2A2A2A}"
				Stroke="DarkGray"
				StrokeThickness="1"
				Padding="12"
				HorizontalOptions="Center"
				VerticalOptions="Center"
				WidthRequest="260"
				HeightRequest="260">
			<patterns:PatternDisplayView PatternCells="{Binding SelectedPattern.Cells}" />
		</Border>

		<!-- ⬇️ Action Buttons -->
		<HorizontalStackLayout Grid.Row="1"
							   Grid.ColumnSpan="2"
							   HorizontalOptions="Center"
							   Spacing="24">
			<controls:IconButton IconName="button_load_pattern"
								 Command="{Binding ConfirmLoadCommand}"
								 IconSize="{OnIdiom Desktop=64, Tablet=54, Phone=48}"
								 IsEnabled="{Binding SelectedPattern}" />

			<controls:IconButton IconName="button_close"
								 Command="{Binding CloseCommand}"
								 IconSize="{OnIdiom Desktop=64, Tablet=54, Phone=48}" />
		</HorizontalStackLayout>
	</Grid>
</ContentView>
