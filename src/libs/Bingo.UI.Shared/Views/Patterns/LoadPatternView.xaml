<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:core="clr-namespace:Bingo.Core.Patterns;assembly=Bingo.Core"
			 xmlns:patterns="clr-namespace:Bingo.UI.Shared.Views.Patterns.PatternDisplay;assembly=Bingo.UI.Shared"
			 xmlns:controls="clr-namespace:Bingo.UI.Shared.Controls;assembly=Bingo.UI.Shared"
			 xmlns:conv="clr-namespace:Bingo.UI.Shared.Converters;assembly=Bingo.UI.Shared"
			 x:Class="Bingo.UI.Shared.Views.Patterns.LoadPatternView"
			 x:Name="Root">

	<ContentView.Resources>
		<conv:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
	</ContentView.Resources>

	<Grid ColumnDefinitions="1.2*,1.8*"
		  RowDefinitions="*,Auto"
		  Padding="12"
		  ColumnSpacing="18"
		  RowSpacing="18">

		<!-- 📁 Scrollable Pattern List -->
		<CollectionView Grid.Column="0"
						ItemsSource="{Binding SavedPatterns}"
						SelectionMode="Single"
						SelectedItem="{Binding SelectedPattern, Mode=TwoWay}"
						VerticalOptions="Fill"
						BackgroundColor="{AppThemeBinding Light=#FDFDFD, Dark=#1A1A1A}">
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="core:BingoPattern">
					<Border Padding="6"
							Margin="0,2"
							Stroke="Gray"
							StrokeThickness="1"
							BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#222}">
						<Label Text="{Binding Name}"
							   FontSize="14"
							   TextColor="{AppThemeBinding Light=Black, Dark=White}" />
						<Border.GestureRecognizers>
							<TapGestureRecognizer Command="{x:Null}" />
						</Border.GestureRecognizers>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<!-- 🔲 Pattern Preview Grid -->
		<Border Grid.Column="1"
				BackgroundColor="{AppThemeBinding Light=#EFEFEF, Dark=#2A2A2A}"
				Stroke="DarkGray"
				StrokeThickness="1"
				Padding="12"
				HorizontalOptions="Center"
				VerticalOptions="Center">
			<patterns:PatternDisplayView PatternCells="{Binding SelectedPattern.Cells}" />
		</Border>

		<!-- ⬇️ Action Buttons -->
		<HorizontalStackLayout Grid.Row="1"
							   Grid.ColumnSpan="2"
							   HorizontalOptions="Center"
							   Spacing="24">

			<controls:IconButton IconName="button_load_pattern"
								 Command="{Binding ConfirmLoadCommand}"
								 IconSize="{OnIdiom Desktop=100, Tablet=80, Phone=60}"
								 IsEnabled="{Binding SelectedPattern, Converter={StaticResource NotNullToBoolConverter}}" />

			<controls:IconButton IconName="button_close"
								 Command="{Binding CloseCommand}"
								 IconSize="{OnIdiom Desktop=100, Tablet=80, Phone=60}" />
		</HorizontalStackLayout>
	</Grid>
</ContentView>
