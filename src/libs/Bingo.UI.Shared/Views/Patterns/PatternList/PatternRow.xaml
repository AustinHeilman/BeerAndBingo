<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:core="clr-namespace:Bingo.Core.Patterns;assembly=Bingo.Core"
			 x:Class="Bingo.UI.Shared.Views.Patterns.PatternList.PatternRow"
			 x:Name="Root">

	<Border x:Name="ItemBorder"
			Padding="6"
			Margin="0,2"
			Stroke="Gray"
			StrokeThickness="1"
			BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#222}">

		<Label x:Name="ItemLabel"
			   Text="{Binding Pattern.Name, Source={x:Reference Root}}"
			   FontSize="14"
			   TextColor="{AppThemeBinding Light=Black, Dark=White}">
			<Label.Triggers>
				<DataTrigger TargetType="Label"
							 Binding="{Binding SelectedPattern, Source={x:Reference Root}}"
							 Value="{Binding Pattern, Source={x:Reference Root}}">
					<Setter Property="FontAttributes"
							Value="Bold" />
				</DataTrigger>
			</Label.Triggers>
		</Label>

		<Border.Triggers>
			<DataTrigger TargetType="Border"
						 Binding="{Binding SelectedPattern, Source={x:Reference Root}}"
						 Value="{Binding Pattern, Source={x:Reference Root}}">
				<Setter Property="Stroke"
						Value="Orange" />
				<Setter Property="StrokeThickness"
						Value="2" />
				<Setter Property="BackgroundColor"
						Value="#FFE4B5" />
			</DataTrigger>
		</Border.Triggers>

		<Border.GestureRecognizers>
			<TapGestureRecognizer Tapped="OnTapped" />
		</Border.GestureRecognizers>
	</Border>
</ContentView>
