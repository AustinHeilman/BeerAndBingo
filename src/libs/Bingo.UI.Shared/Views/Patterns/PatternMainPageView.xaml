<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Name="self"
			 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 x:Class="Bingo.UI.Shared.Views.Patterns.PatternMainPageView"
			 xmlns:controls="clr-namespace:Bingo.UI.Shared.Controls;assembly=Bingo.UI.Shared">

	<Grid HorizontalOptions="Center"
		  VerticalOptions="Center">
		<HorizontalStackLayout Spacing="12">			
			<controls:IconButton IconName="button_create_pattern"
								 Command="{Binding CreatePatternCommand}"
								 IconSize="{OnIdiom Desktop=100, Tablet=80, Phone=60}" />
			<controls:IconButton IconName="button_load_pattern"
								 Command="{Binding LoadPatternCommand}"
								 IconSize="{OnIdiom Desktop=100, Tablet=80, Phone=60}" />
			<controls:IconButton IconName="button_clear_pattern"
								 Command="{Binding ClearPatternCommand}"
								 IconSize="{OnIdiom Desktop=100, Tablet=80, Phone=60}" />
			<controls:IconButton IconName="button_close"
								 Command="{Binding CloseSheetCommand}"
								 IconSize="{OnIdiom Desktop=100, Tablet=80, Phone=60}" />
		</HorizontalStackLayout>
	</Grid>

</ContentView>