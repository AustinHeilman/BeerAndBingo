<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Bingo.UI.Shared.Styles.FlashBoardTheme"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Bingo.UI.Shared.Converters">

    <!-- 🔤 Typography + Layout: Number Cell -->
    <Style x:Key="FlashBoardNumberCell" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource FlashBoardNumberFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FlashBoardNumberFontSize}" />
        <Setter Property="FontAttributes" Value="{DynamicResource FlashBoardNumberFontAttributes}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="TextColor" Value="{DynamicResource FlashBoardCellTextColor_Uncalled}" />

        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsCalled}" Value="True">
                <Setter Property="TextColor" Value="{DynamicResource FlashBoardCellTextColor_Called}" />
                <!-- <Setter Property="BackgroundColor" Value="{DynamicResource FlashBoardCellBGColor_Called}" /> -->
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 🔠 Typography: Header Cell -->
    <Style x:Key="FlashBoardHeaderLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource FlashBoardHeaderFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FlashBoardHeaderFontSize}" />
        <Setter Property="FontAttributes" Value="{DynamicResource FlashBoardHeaderFontAttributes}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!-- 🎨 Color Resources -->
    <Color x:Key="FlashBoardBackgroundColor">Transparent</Color>
    <SolidColorBrush x:Key="FlashBoardBackgroundBrush" Color="{StaticResource FlashBoardBackgroundColor}" />

    <Color x:Key="FlashBoardCellBGColor_Uncalled">#707070</Color>
    <Color x:Key="FlashBoardCellBGColor_Called">#FFD700</Color>

    <Color x:Key="FlashBoardCellTextColor_Uncalled">Gray</Color>
    <Color x:Key="FlashBoardCellTextColor_Called">Black</Color>

    <SolidColorBrush x:Key="FlashBoardCellBGBrush_Uncalled" Color="{StaticResource FlashBoardCellBGColor_Uncalled}" />
    <SolidColorBrush x:Key="FlashBoardCellBGBrush_Called" Color="{StaticResource FlashBoardCellBGColor_Called}" />

    <!-- 🔁 Converters -->
    <converters:BoolToCellBackgroundConverter x:Key="CellBackgroundConverter"
        TrueValue="{StaticResource FlashBoardCellBGBrush_Called}"
        FalseValue="{StaticResource FlashBoardCellBGBrush_Uncalled}" />

    <converters:BoolToCellTextColorConverter x:Key="CellTextColorConverter"
        TrueValue="{StaticResource FlashBoardCellTextColor_Called}"
        FalseValue="{StaticResource FlashBoardCellTextColor_Uncalled}" />
</ResourceDictionary>
