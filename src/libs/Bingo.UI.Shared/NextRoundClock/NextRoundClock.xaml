<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bingo.UI.Shared.NextRoundClock.NextRoundClock"
             x:Name="RootClock"
             BackgroundColor="Transparent">

	<VerticalStackLayout Padding="16" Spacing="8"
                         IsVisible="{Binding ViewModel.IsVisible}">
		<Label Text="Next Round Starts At:" FontSize="18"
               HorizontalOptions="Center" />
		<Label Text="{Binding ViewModel.DisplayScheduled}" FontSize="22"
               HorizontalOptions="Center" />

		<Label Text="{Binding ViewModel.DisplayCountdown}" FontSize="36"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="Crimson" />

		<StackLayout IsVisible="{Binding ViewModel.IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                     Spacing="12">
			<Entry x:Name="MinutesEntry"
                   Placeholder="Enter minutes..."
                   Keyboard="Numeric"
                   HorizontalOptions="Center"
                   WidthRequest="140" />
			<Button Text="Set Timer" Clicked="OnSetTimerClicked" />
			<Button Text="Cancel" Clicked="OnCancelClicked" />
		</StackLayout>
	</VerticalStackLayout>
</ContentView>
