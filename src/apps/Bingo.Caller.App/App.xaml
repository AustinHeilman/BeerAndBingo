<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Bingo.Caller.App"
             xmlns:conv="clr-namespace:Bingo.UI.Shared.Converters;assembly=Bingo.UI.Shared"
             x:Class="Bingo.Caller.App.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters go here outside of MergedDictionaries -->
            <conv:BoolToCellBackgroundConverter x:Key="BoolToCellBackgroundConverter" />
            <conv:BoolToCellTextColorConverter x:Key="BoolToCellTextColorConverter" />
        </ResourceDictionary>
    </Application.Resources>

</Application>
