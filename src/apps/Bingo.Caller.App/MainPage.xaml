<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pattern="clr-namespace:Bingo.UI.Shared.Views.Patterns.PatternDisplay;assembly=Bingo.UI.Shared"
             xmlns:game="clr-namespace:Bingo.UI.Shared.Views.GameInfo;assembly=Bingo.UI.Shared"
             xmlns:controls="clr-namespace:Bingo.UI.Shared.Controls;assembly=Bingo.UI.Shared"
             x:Class="Bingo.Caller.App.MainPage"
             BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">

	<Grid x:Name="MainGrid"
          RowSpacing="8"
          ColumnSpacing="12"
          Padding="0,0,16,16">

		<Grid.RowDefinitions>
			<RowDefinition Height="3*" />
			<RowDefinition Height="2*" />
		</Grid.RowDefinitions>

		<!-- FlashBoardView injected via code-behind into Row 0 -->

		<!-- Bottom UI Grid -->
		<Grid Grid.Row="1" ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.5*" />
				<!-- Flight Bar -->
				<ColumnDefinition Width="Auto" />
				<!-- Call Button -->
				<ColumnDefinition Width="2.5*" />
				<!-- Pattern -->
				<ColumnDefinition Width="2.0*" />
				<!-- Game Info -->
			</Grid.ColumnDefinitions>

			<!-- Flight Bar Placeholder -->
			<BoxView Grid.Column="0"
                     BackgroundColor="#222"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill" />

			<!-- Next Call Button -->
			<Image Grid.Column="1"
                   Source="button_next_pick_win.png"
                   WidthRequest="72"
                   HeightRequest="72"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

			<!-- Pattern with name label -->
			<VerticalStackLayout Grid.Column="2"
                                 Spacing="4"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
				<Label Text="Pattern: None"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="DimGray" />
				<pattern:PatternDisplayView
                    WidthRequest="360"
                    ViewModel="{Binding PatternVM}"
                    BackgroundColor="Transparent" />
			</VerticalStackLayout>

			<!-- Reusable Game Info Panel -->
			<game:GameInfoPanel Grid.Column="3"
                                VerticalOptions="Center"
                                HorizontalOptions="Fill"
                                BindingContext="{Binding GameInfoVM}" />
		</Grid>
	</Grid>
</ContentPage>
