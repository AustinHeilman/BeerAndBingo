<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:flash="clr-namespace:Bingo.UI.Shared.Views.FlashBoard;assembly=Bingo.UI.Shared"
             xmlns:pattern="clr-namespace:Bingo.UI.Shared.Views.Patterns.PatternDisplay;assembly=Bingo.UI.Shared"
             xmlns:controls="clr-namespace:Bingo.UI.Shared.Controls;assembly=Bingo.UI.Shared"
             xmlns:gameinfo="clr-namespace:Bingo.UI.Shared.Views.GameInfoPanel;assembly=Bingo.UI.Shared"
             xmlns:views="clr-namespace:Bingo.UI.Shared.Views.NextRoundClock;assembly=Bingo.UI.Shared"
             xmlns:converters="clr-namespace:Bingo.UI.Shared.Converters;assembly=Bingo.UI.Shared"
             x:Class="Bingo.Caller.App.MainPage"
             x:Name="RootPage"
             BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">

	<ContentPage.Resources>
		<Style TargetType="Button">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Padding" Value="4,2" />
		</Style>
		<converters:InverseBoolConverter x:Key="InverseBoolConverter" />
	</ContentPage.Resources>

	<Grid x:Name="MainGrid" RowSpacing="8" ColumnSpacing="12" Padding="0,0,16,16">
		<Grid.RowDefinitions>
			<RowDefinition Height="5*" />
			<!-- FlashBoard -->
			<RowDefinition Height="2*" />
			<!-- Control Bar -->
		</Grid.RowDefinitions>

		<!-- FlashBoard is injected dynamically at Grid.Row=0 -->

		<!-- Control Panel -->
		<Grid Grid.Row="1" ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="3*" />
			</Grid.ColumnDefinitions>

			<controls:IconButton Grid.Column="0"
                                 IconName="button_next_pick"
                                 Command="{Binding viewModel.NextCallCommand}"
                                 IconSize="{OnIdiom Desktop=200, Tablet=150, Phone=100}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Margin="0,0,8,0" />

			<gameinfo:GameInfoPanel Grid.Column="1"
                                    BindingContext="{Binding viewModel.GameInfoVM}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Fill" />

			<!-- Pattern Preview Thumbnail -->
			<ContentView Grid.Column="2">
				<ContentView.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding page.TogglePatternZoomCommand}" />
				</ContentView.GestureRecognizers>
				<Border WidthRequest="{OnIdiom Phone=140, Tablet=200, Desktop=240}"
                        MinimumHeightRequest="{OnIdiom Phone=160, Tablet=240, Desktop=280}"
                        BackgroundColor="{AppThemeBinding Light=#EFEFEF, Dark=#1A1A1A}"
                        StrokeShape="RoundRectangle 6"
                        HorizontalOptions="Center"
                        VerticalOptions="Fill">
					<pattern:PatternDisplayView ViewModel="{Binding viewModel.PatternVM}" />
				</Border>
			</ContentView>
		</Grid>

		<!-- Tools Panel (Dock-Style Strip) -->
		<Grid Grid.Row="1"
              VerticalOptions="End"
              HeightRequest="{OnIdiom Phone=120, Tablet=150, Desktop=150}"
              BackgroundColor="#80000000"
              IsVisible="{Binding viewModel.IsToolsPanelVisible}"
              InputTransparent="False"
              ZIndex="100">
			<Grid BackgroundColor="DarkSlateGray"
                  HeightRequest="{OnIdiom Phone=100, Tablet=120, Desktop=110}"
                  Padding="12,0"
                  VerticalOptions="Fill"				  
                  HorizontalOptions="Start">
				<HorizontalStackLayout HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Spacing="12">
					<controls:IconButton IconName="button_new_game" Command="{Binding page.NewGameCommand}"       IconSize="{OnIdiom Desktop=100, Tablet=100, Phone=80}" />
					<controls:IconButton IconName="button_nextgame" Command="{Binding page.NextClockCommand}"     IconSize="{OnIdiom Desktop=100, Tablet=100, Phone=80}" />
					<controls:IconButton IconName="button_patterns" Command="{Binding viewModel.PatternsCommand}" IconSize="{OnIdiom Desktop=100, Tablet=100, Phone=80}" />
					<controls:IconButton IconName="button_undo_pick" Command="{Binding page.UndoPickCommand}"     IconSize="{OnIdiom Desktop=100, Tablet=100, Phone=80}" />
					<controls:IconButton IconName="button_redo_pick" Command="{Binding page.RedoPickCommand}"     IconSize="{OnIdiom Desktop=100, Tablet=100, Phone=80}" />
					<controls:IconButton IconName="button_replay" Command="{Binding page.ReplayCommand}"          IconSize="{OnIdiom Desktop=100, Tablet=100, Phone=80}" />
					<controls:IconButton IconName="button_settings" Command="{Binding viewModel.SettingsCommand}" IconSize="{OnIdiom Desktop=100, Tablet=100, Phone=80}" />
					<controls:IconButton IconName="{Binding viewModel.ToolsPanelToggleIcon}"
                                         Command="{Binding viewModel.ToggleToolsPanelCommand}"
                                         IconSize="{OnIdiom Desktop=50, Tablet=50, Phone=30}" />
				</HorizontalStackLayout>
			</Grid>
		</Grid>

		<!-- Toggle Button (Collapsed) -->
		<controls:IconButton Grid.Row="1"
                             IconName="{Binding viewModel.ToolsPanelToggleIcon}"
                             Command="{Binding viewModel.ToggleToolsPanelCommand}"
                             IconSize="{OnIdiom Desktop=50, Tablet=50, Phone=30}"
                             HorizontalOptions="Start"
                             VerticalOptions="Center"
                             Margin="0"
                             IsVisible="{Binding viewModel.IsToolsPanelVisible, Converter={StaticResource InverseBoolConverter}}" />

		<!-- Pattern Zoom Modal -->
		<ContentView Grid.RowSpan="2"
                     BackgroundColor="#88000000"
                     IsVisible="{Binding page.IsPatternZoomed}"
                     InputTransparent="False"
                     ZIndex="46">
			<ContentView.GestureRecognizers>
				<TapGestureRecognizer Command="{Binding page.TogglePatternZoomCommand}" />
			</ContentView.GestureRecognizers>
			<Border WidthRequest="{OnIdiom Phone=350, Tablet=550, Desktop=720}"
                    HeightRequest="{OnIdiom Phone=350, Tablet=550, Desktop=720}"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#222}"
                    Padding="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
				<Border.Shadow>
					<Shadow Brush="Black" Offset="4,4" Radius="6" Opacity="0.4" />
				</Border.Shadow>
				<pattern:PatternDisplayView BindingContext="{Binding viewModel.PatternVM}" />
			</Border>
		</ContentView>

		<!-- Timer Backdrop -->
		<ContentView Grid.RowSpan="2"
                     BackgroundColor="#88000000"
                     IsVisible="{Binding page.NextClockVisible}"
                     InputTransparent="False"
                     ZIndex="45" />

		<!-- Timer Modal -->
		<views:NextRoundClock x:Name="NextClockOverlay"
                              Grid.RowSpan="2"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              IsVisible="{Binding page.NextClockVisible}"
                              InputTransparent="False"
                              ZIndex="50" />
	</Grid>
</ContentPage>
