<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:flash="clr-namespace:Bingo.UI.Shared.Views.FlashBoard;assembly=Bingo.UI.Shared"
             xmlns:pattern="clr-namespace:Bingo.UI.Shared.Views.Patterns.PatternDisplay;assembly=Bingo.UI.Shared"
             x:Class="Bingo.Caller.App.MainPage"
             BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">

    <Grid x:Name="MainGrid" RowSpacing="8" ColumnSpacing="12" Padding="0,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- The FlashBoardView will be added to MainGrid in code-behind -->

        <!-- Caller Tools + Pattern Grid -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Tools Panel -->
            <VerticalStackLayout Grid.Column="0" Spacing="8">
                <Label Text="Caller Tools" FontAttributes="Bold" />
                <!-- Add toggle buttons, win checkers, etc. -->
            </VerticalStackLayout>

            <!-- Pattern Grid -->
            
        </Grid>
    </Grid>
</ContentPage>
